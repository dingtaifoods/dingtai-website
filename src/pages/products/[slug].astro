---
import Layout from "../../layouts/Layout.astro";
import InquiryForm from "../../components/InquiryForm.astro";
import { products, getProduct } from "../../data/site";

export function getStaticPaths() {
  return products.map((product) => ({ params: { slug: product.slug } }));
}

const { slug } = Astro.params;
const product = getProduct(slug ?? "");
if (!product) {
  throw new Error("Product not found");
}
---

<Layout title={product.name} description={product.summary}>
  <section class="page-hero">
    <div class="wrap">
      <p class="kicker">{product.category}</p>
      <h1>{product.name}</h1>
      <p>{product.summary}</p>
    </div>
  </section>
  <section class="section">
    <div class="wrap grid-2">
      <div>
        <img class="card" src={product.heroImage} alt={product.name} />
        <ul class="pill-list" style="margin-top: 16px;">
          {product.highlights.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
        <div class="grid-2" style="margin-top: 16px; align-items: stretch;">
          {product.gallery.map((src) => (
            <img class="card" src={src} alt={`${product.name} detail`} loading="lazy" />
          ))}
        </div>
      </div>
      <div>
        <h2>Specifications</h2>
        <table class="table">
          {product.specs.map(([label, value]) => (
            <tr>
              <th>{label}</th>
              <td>{value}</td>
            </tr>
          ))}
        </table>
        <h3 style="margin-top: 28px;">Typical applications</h3>
        <ul>
          {product.applications.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>
    </div>
  </section>
  <section class="section" style="background: var(--paper-2);">
    <div class="wrap" style="max-width: 720px;">
      <InquiryForm selected={product.slug} />
    </div>
  </section>
</Layout>
