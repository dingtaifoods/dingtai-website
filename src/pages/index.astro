<script>
  // 导航栏滚动特效
  const header = document.querySelector(".global-header");
  window.addEventListener("scroll", () => {
    if (window.scrollY > 50) {
      header.classList.add("scrolled");
    } else {
      header.classList.remove("scrolled");
    }
  });

  // 首屏淡入淡出轮播
  const slides = document.querySelectorAll('.hero-bg');
  let current = 0;
  setInterval(() => {
    slides[current].classList.remove('active');
    current = (current + 1) % slides.length;
    slides[current].classList.add('active');
  }, 5000);

  // 滚动淡入动画
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('visible');
      }
    });
  }, { threshold: 0.1 });

  document.querySelectorAll('.fade-in').forEach((el) => {
    observer.observe(el);
  });

  // ================= 表单提交逻辑 =================
  const form = document.getElementById('inquiryForm');
  const submitBtn = document.getElementById('submitBtn');

  if (form) {
    form.addEventListener('submit', function(e) {
      e.preventDefault(); // 阻止页面跳转刷新
      
      const formData = new FormData(form);
      const object = Object.fromEntries(formData);
      const json = JSON.stringify(object);
      
      submitBtn.innerHTML = "Sending..."; // 按钮变成发送中
      submitBtn.disabled = true;

      fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: {
              'Content-Type': 'application/json',
              'Accept': 'application/json'
          },
          body: json
      })
      .then(async (response) => {
          let json = await response.json();
          if (response.status == 200) {
              // 发送成功
              submitBtn.innerHTML = "Inquiry Sent Successfully!";
              submitBtn.style.backgroundColor = "#28a745"; // 变成绿色
              form.reset(); // 清空表单内容
              
              // 3秒后恢复按钮原样
              setTimeout(() => {
                submitBtn.innerHTML = "Send Inquiry";
                submitBtn.style.backgroundColor = "#3A824F";
                submitBtn.disabled = false;
              }, 3000);
          } else {
              // 发送失败
              console.log(response);
              submitBtn.innerHTML = "Something went wrong. Try again.";
              submitBtn.style.backgroundColor = "#dc3545"; // 变成红色
          }
      })
      .catch(error => {
          console.log(error);
          submitBtn.innerHTML = "Something went wrong.";
          submitBtn.style.backgroundColor = "#dc3545";
      });
    });
  }

  // ================= 产品卡片一键带入询盘逻辑 =================
  const productCards = document.querySelectorAll('.product-card');
  const targetProductInput = document.querySelector('input[name="Target Product"]');

  productCards.forEach(card => {
    card.addEventListener('click', function() {
      // 获取我们在 HTML 里写的 data-product 属性
      const productName = this.getAttribute('data-product');
      
      // 将产品名字填入表单的 Target Product 框
      if (targetProductInput && productName) {
        targetProductInput.value = productName;
      }

      // 平滑滚动到底部的表单区域
      const contactSection = document.getElementById('contact');
      if (contactSection) {
        contactSection.scrollIntoView({ behavior: 'smooth' });
      }
    });
  });
</script>