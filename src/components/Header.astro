---
import { nav } from "../data/site";

const path = Astro.url.pathname;
---

<header class="site-header">
  <div class="wrap header-inner">
    <a class="logo" href="/">
      <img src="/images/dingtai-logo.jpg" alt="Dingtai Food Logo" style="height: 36px; width: auto;" />
      <div>
        <strong>Dingtai</strong>
        <span>Luoping Ginger</span>
      </div>
    </a >
    <button class="menu-toggle" type="button" aria-label="Open menu" data-menu-toggle>
      Menu
    </button>
    <nav class="nav" data-nav>
      {nav.map((item) => (
        <a href={item.href} aria-current={path === item.href ? "page" : undefined}>
          {item.label}
        </a >
      ))}
      <a class="btn btn-primary" href="/contact">Request a quote</a >
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector("[data-menu-toggle]");
  const nav = document.querySelector("[data-nav]");
  toggle?.addEventListener("click", () => nav?.classList.toggle("is-open"));
</script>